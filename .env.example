# Shared by all three workstreams. Copy to .env — never commit the real one.

# Postgres. Production is RDS in ap-south-1, reachable only from the storefront
# instance's security group — there is no public endpoint, so you cannot connect
# to it from a laptop without going through the box. Local development points at
# whatever you like; Neon's free tier is the low-friction option.
#   prod  postgresql://physisync:<pw>@physisync-db.xxxx.ap-south-1.rds.amazonaws.com:5432/physisync
#   dev   postgresql://user:pass@ep-xxx.aws.neon.tech/rto?sslmode=require
DATABASE_URL="postgresql://user:pass@localhost:5432/physisync"

# L2 — Rohit (Twilio WhatsApp)
TWILIO_ACCOUNT_SID=""
# Scoped API key — preferred. The account auth token below is the fallback.
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_AUTH_TOKEN=""
# Sender, with the channel prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=""
# Unset = send our own per-order copy (needs the 24h window open).
# Set = send this approved Content template instead (needed to open a chat cold).
# TWILIO_WHATSAPP_CONTENT_SID=""
# Optional: public URL Twilio posts delivery receipts to.
TWILIO_STATUS_CALLBACK_URL=""

# L3 — Devang (Sarvam AI Instant Outbound)
SARVAM_API_KEY=""
SARVAM_ORG_ID=""
SARVAM_WORKSPACE_ID=""
SARVAM_APP_ID=""
SARVAM_CONNECTION_ID=""
SARVAM_PHONE_NUMBER=""
SARVAM_APP_VERSION="1"

# Demo
DEMO_PHONE="+9198XXXXXXXX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Deploy origins. The landing page (apps/site) and the demo storefront
# (apps/web) ship to different hosts, so the landing page's cross-app links
# are built from these. NEXT_PUBLIC_* is inlined at BUILD time — set them in
# the build environment, not just the runtime one.
#   apps/site  -> physisync.co.in
#   apps/web   -> demo.physisync.co.in
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# Origin serving the MediaPipe wasm runtime and the pose model — 38MB that
# every cold visitor pays for. Empty = same origin, which is what you want
# locally (they are already in apps/web/public). In production point it at
# CloudFront and push with scripts/cdn-sync.sh.
#   NEXT_PUBLIC_CDN_URL="https://cdn.physisync.co.in"
# NOT widget.js — it builds its iframe URL from its own script origin, so it
# has to keep being served from the app itself.
NEXT_PUBLIC_CDN_URL=""


# Try-on preview (optional). ROTATE THIS IF IT WAS EVER PASTED IN CHAT.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2"
